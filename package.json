{
  "name": "silence-speedup",
  "productName": "Silence SpeedUp",
  "version": "2.0.0",
  "description": "Speed-up your videos speeding-up (or removing) silences, using FFmpeg. This is an electron-based app.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . Silence-SpeedUp --icon=assets/icons/icon.png --out=build --overwrite --prune=true",
    "package-win": "electron-packager . Silence-SpeedUp --platform=win32 --arch=x64 --icon=assets/icons/icon.ico --out=build --overwrite",
    "package-mac": "electron-packager . Silence-SpeedUp --platform=darwin --arch=x64 --icon=assets/icons/icon.png --out=build --overwrite",
    "package-linux": "electron-packager . Silence-SpeedUp --platform=linux --arch=x64 --icon=assets/icons/icon.png --out=build --overwrite"
  },
  "author": {
    "name": "Vincenzo Padula",
    "email": "padvincenzo@gmail.com",
    "url": "https://vincenzopadula.altervista.org/"
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/padvincenzo/silence-speedup"
  },
  "bugs": "https://github.com/padvincenzo/silence-speedup/issues",
  "homepage": "https://github.com/padvincenzo/silence-speedup#readme",
  "keywords": [
    "silence-speedup",
    "video-editing",
    "silence",
    "ffmpeg",
    "videos",
    "electron",
    "electron-app",
    "silence-skip",
    "skip-silence",
    "speedup",
    "videos-speeding",
    "silences"
  ],
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.6",
    "agentkeepalive": "^4.6.0",
    "bootstrap": "^5.3.3",
    "decompress-zip": "^0.3.3",
    "electron-download-manager": "^2.1.2",
    "feed-read": "0.0.1",
    "font-awesome": "^4.7.0",
    "fs-extra": "^11.3.0",
    "hosted-git-info": "^8.0.2",
    "i18next": "^25.0.2",
    "i18next-browser-languagedetector": "^8.1.0",
    "i18next-fs-backend": "^2.6.0",
    "video.js": "^8.21.0",
    "videojs-silence-speedup": "^1.1.8"
  }
}